FROM golang:1.24-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/agentapi ./main.go

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/agentapi /agentapi
USER nonroot:nonroot
ENTRYPOINT ["/agentapi", "discord"]
