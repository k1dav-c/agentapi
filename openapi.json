          },
          "ok": {
            "description": "Indicates whether the message was accepted.",
            "type": "boolean"
          },
          "queued": {
            "description": "Indicates whether a user message was queued because the agent was busy.",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "queued"
        ],
        "type": "object"
      },
      "MessageType": {
        "enum": [
